{
  "name": "k0t3i-site-dev",
  "private": true,
  "type": "module",
  "description": "Dev and test tooling for the static home page. Never loaded by the page.",
  "scripts": {
    "serve": "node serve.mjs",
    "test:static": "node --test \"tests/static/*.test.mjs\"",
    "test:e2e": "playwright test",
    "validate": "node scripts/validate.mjs",
    "test": "npm run test:static && npm run test:e2e && npm run validate"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.0",
    "html-validate": "11.18.0",
    "lighthouse": "13.6.0",
    "vnu-jar": "26.11.3"
  }
}
